# Sem DATABASE_URL, o PostgreSQL embarcado persiste em ./data/postgres.
# DATABASE_URL=postgres://quadro:quadro@localhost:5432/quadro
HOST=127.0.0.1
PORT=3001
# Para hospedar a aplicação, configure também a origem exata do navegador.
APP_ORIGIN=http://localhost:3001
# Proxies na frente da aplicação (nginx/openresty). Padrão 1: o IP de cada pessoa vem do proxy,
# e os limites de login valem por pessoa, não para a empresa inteira. Use false se ninguém
# fica na frente e a porta é acessada direto.
# TRUST_PROXY=1
# Login: none (sem login, perfil local único), local (e-mail e senha, com contas criadas
# por um administrador; o primeiro acesso cria o administrador) ou oidc (usuário e senha da rede,
# validados no Keycloak, como no Hefesto; a primeira pessoa a entrar vira administradora e as
# demais chegam como leitor).
AUTH_MODE=none
# Keycloak (AUTH_MODE=oidc). O client precisa de Client authentication e Direct access grants
# ligados. O segredo fica só aqui, nunca no código ou em mensagens.
# OIDC_ISSUER=https://auth.exemplo.com.br/realms/NOME_DO_REALM
# OIDC_CLIENT_ID=quadroos
# OIDC_CLIENT_SECRET=
# Grupo exigido na claim "groups" (vazio: vale o filtro do grupo AD na federação do realm).
# OIDC_REQUIRED_GROUP=
# Dados fictícios na primeira execução. Use false para começar vazio.
SEED_DEMO=true
# Versão estável explicitamente selecionada para o conector monday.
MONDAY_API_VERSION=2026-10
# Limites da cópia de arquivos na importação (100 MB por arquivo, 1 GB por prévia).
# MAX_MONDAY_FILE_BYTES=104857600
# MAX_MONDAY_IMPORT_BYTES=1073741824
