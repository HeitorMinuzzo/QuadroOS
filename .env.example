# Sem DATABASE_URL, o PostgreSQL embarcado persiste em ./data/postgres.
# DATABASE_URL=postgres://quadro:quadro@localhost:5432/quadro
HOST=127.0.0.1
PORT=3001
# Para hospedar a aplicação, configure também a origem exata do navegador.
APP_ORIGIN=http://localhost:3001
# Dados fictícios na primeira execução. Use false para começar vazio.
SEED_DEMO=true
# Versão estável explicitamente selecionada para o conector monday.
MONDAY_API_VERSION=2026-10
# Limites da cópia de arquivos na importação (100 MB por arquivo, 1 GB por prévia).
# MAX_MONDAY_FILE_BYTES=104857600
# MAX_MONDAY_IMPORT_BYTES=1073741824
